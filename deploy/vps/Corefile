# Split DNS for the tailnet (Tailscale: nameserver 100.67.67.24, restrict to domain lampt.works).
# Names hosted on vps2 resolve to its Tailscale IP; every other *.lampt.works
# name is forwarded to Cloudflare so it resolves exactly as on the internet.
lampt.works:53 {
    bind 100.67.67.24
    hosts {
        100.67.67.24 9r.lampt.works
        100.67.67.24 manage.lampt.works
        ttl 60
        fallthrough
    }
    # Tailnet-only names have no IPv6 here; answer AAAA with NOERROR/empty so
    # clients don't fall back to the public (Cloudflare) AAAA record.
    template IN AAAA 9r.lampt.works manage.lampt.works {
        rcode NOERROR
    }
    forward . 1.1.1.1 1.0.0.1
    cache 60
    errors
}
