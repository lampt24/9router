{
	# Only the Tailscale address — never the public NIC.
	default_bind {$TS_IP}
	admin off
}

9r.lampt.works {
	tls {
		dns cloudflare {$CF_DNS_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:20128 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# Relay origin for the Cloudflare "relay.lampt.works" TCP-over-WebSocket path.
# cloudflared forwards raw TCP here; going through Caddy guarantees an
# X-Forwarded-For header, so 9router marks the request "via proxy" and never
# treats it as a trusted local (keyless/admin) request. Only /v1 is exposed.
http://:20129 {
	bind 127.0.0.1
	@v1 path /v1 /v1/*
	handle @v1 {
		reverse_proxy 127.0.0.1:20128 {
			header_up -X-Real-IP
			header_up X-Forwarded-For "relay"
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}
	handle {
		respond 404
	}
}
