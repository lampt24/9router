{
	# Only the Tailscale address — never the public NIC.
	default_bind {$TS_IP}
	admin off
}

9r.lampt.works {
	tls {
		dns cloudflare {$CF_DNS_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode zstd gzip
	reverse_proxy 127.0.0.1:20128 {
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

# VPS admin (tailnet only): Cockpit. Add-ons can mount extra routes in front of it
# by dropping files into /etc/caddy-extra/manage/ on the host.
manage.lampt.works {
	tls {
		dns cloudflare {$CF_DNS_API_TOKEN}
		resolvers 1.1.1.1
	}
	encode zstd gzip
	import /etc/caddy/extra/manage/*.caddy
	handle {
		reverse_proxy 127.0.0.1:9090 {
			header_up X-Forwarded-Proto https
		}
	}
}

# Add-on sites (host /etc/caddy-extra/*.caddy, static files under /srv/caddy-extra),
# Empty directories are fine.
import /etc/caddy/extra/*.caddy
